; The Last Street: Godot project for the 3D prototype.
; The simulation is C++ in core/, loaded through godot/the_last_street.gdextension.

config_version=5

[application]

config/name="The Last Street"
run/main_scene="res://godot/scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1440
window/size/viewport_height=900

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
